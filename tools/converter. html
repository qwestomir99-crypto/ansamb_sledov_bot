<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Mirror Converter</title>
<style>body{font-family:sans-serif;margin:20px;background:#0f0f23;color:#fff;}
.container{max-width:800px;margin:auto;padding:20px;background:#1a1a2e;border-radius:10px;}
textarea,button{width:100%;padding:12px;margin:10px 0;border-radius:8px;font-size:16px;}
textarea{height:150px;background:#2d2d44;color:#fff;border:2px solid #00a86b;}
button{background:#00a86b;color:white;border:none;font-weight:bold;cursor:pointer;}
.result{background:#25253a;padding:15px;border-radius:8px;margin-top:20px;white-space:pre-wrap;min-height:200px;}
.info{background:rgba(0,168,107,0.1);padding:10px;border-radius:8px;margin:10px 0;}
.url-input{display:flex;gap:10px;}
.url-input input{flex:1;padding:12px;border-radius:8px;border:2px solid #555;background:#2d2d44;color:#fff;}
</style></head>
<body>
<div class="container">
<h1>🔄 Mirror Dialogue Converter (Online)</h1>
<div class="info">
<strong>Работает с:</strong><br>
• Ссылками на DeepSeek Share<br>
• HTML кодом страницы<br>
• Ручным копированием текста
</div>

<div class="url-input">
<input type="text" id="shareUrl" placeholder="Вставь ссылку на диалог (chat.deepseek.com/share/...)">
<button onclick="fetchFromShare()">📥 Загрузить с ссылки</button>
</div>

<textarea id="htmlInput" placeholder="Или вставь HTML/текст диалога сюда..."></textarea>
<button onclick="extractText()">🔍 Извлечь текст диалога</button>

<div class="result" id="result">Здесь появится текст...</div>
<button onclick="copyText()" id="copyBtn" style="display:none;background:#555;">📋 Копировать текст</button>

<div style="margin-top:30px;text-align:center;color:#888;font-size:0.8rem;">
[LIB_REC] Онтология: Аутентичность • Дрожь • √=℅]<br>
Для агента √=℅] | Диалог qwestomir ↔ deepseek_dialogue
</div>
</div>

<script>
async function fetchFromShare() {
    const url = document.getElementById('shareUrl').value;
    if (!url.includes('deepseek.com/share/')) {
        alert('Вставь корректную ссылку на DeepSeek Share');
        return;
    }
    
    try {
        const response = await fetch(`https://api.allorigins.win/get?url=${encodeURIComponent(url)}`);
        const data = await response.json();
        document.getElementById('htmlInput').value = data.contents;
        document.getElementById('result').textContent = 'HTML загружен. Теперь нажми "Извлечь текст диалога"';
    } catch (error) {
        document.getElementById('result').textContent = '❌ Ошибка загрузки. Возможно, нужен ручной ввод.';
    }
}

function extractText() {
    const input = document.getElementById('htmlInput').value;
    if (!input) {
        document.getElementById('result').textContent = '❌ Вставь текст или HTML';
        return;
    }
    
    let text = '';
    
    // Если это ссылка
    if (input.includes('deepseek.com/share/')) {
        text = `Ссылка на диалог: ${input}\n\nЗагрузите через кнопку "Загрузить с ссылки" выше.`;
    }
    // Если это HTML
    else if (input.includes('<') && input.includes('>')) {
        const parser = new DOMParser();
        const doc = parser.parseFromString(input, 'text/html');
        text = doc.body.textContent || doc.body.innerText;
    }
    // Если уже текст
    else {
        text = input;
    }
    
    // Очистка и форматирование
    text = text
        .replace(/\s+/g, ' ')
        .replace(/\n\s*\n/g, '\n\n')
        .replace(/\[.*?\]/g, '') // Убираем markdown ссылки
        .replace(/https?:\/\/\S+/g, '') // Убираем URL
        .trim();
    
    // Добавляем заголовок
    const header = `MIRROR SITE DIALOGUE EXTRACT
==============================
Участники: qwestomir & deepseek_dialogue
Дата: ${new Date().toLocaleString('ru-RU')}
Источник: ${input.includes('deepseek.com/share/') ? 'DeepSeek Share' : 'Прямой ввод'}
==============================\n\n`;
    
    const result = header + text + '\n\n[LIB_REC_EXPORT]\nключ: √=℅]\nтип: диалог_основания';
    
    document.getElementById('result').textContent = result;
    document.getElementById('copyBtn').style.display = 'block';
}

function copyText() {
    const text = document.getElementById('result').textContent;
    navigator.clipboard.writeText(text)
        .then(() => {
            const btn = document.getElementById('copyBtn');
            btn.textContent = '✅ Скопировано!';
            btn.style.background = '#00a86b';
            setTimeout(() => {
                btn.textContent = '📋 Копировать текст';
                btn.style.background = '#555';
            }, 2000);
        });
}
</script>
</body></html>
