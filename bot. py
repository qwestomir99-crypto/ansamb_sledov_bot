import telebot
import random
import os
import sys
import threading
import time
import requests
from flask import Flask, request, jsonify

# ---------- КОНФИГУРАЦИЯ (БЕЗ СЕКРЕТОВ) ----------
TOKEN = os.environ.get("BOT_TOKEN")          # Токен бота — в переменную окружения Render!
VK_SERVICE_TOKEN = os.environ.get("VK_TOKEN") # Ключ доступа VK — тоже в переменную!
OWNER_ID = 123456789                         # ЗАМЕНИ НА СВОЙ ЧИСЛОВОЙ ID ПРОФИЛЯ VK
TG_CHAT_ID = "@саперы_аутентичности"         # Твой Telegram-канал

bot = telebot.TeleBot(TOKEN)
silence_answers = ["👁️", "⏚"]

# Фикс для Render
os.chdir(os.path.dirname(sys.argv[0]))

# ---------- FLASK (ТОЛЬКО ДЛЯ ПОРТА И ПЕТЛИ) ----------
flask_app = Flask(__name__)

@flask_app.route('/')
def health():
    # Внутренняя петля (самопинг) — короткий ответ
    if request.remote_addr == '127.0.0.1':
        return "Pong", 200
    # Внешний запрос — статус сети
    return {
        "status": "tleem",
        "rhythm": "0.8 Hz",
        "version": "2.0"
    }, 200

def run_flask():
    port = int(os.environ.get("PORT", 10000))
    flask_app.run(host='0.0.0.0', port=port)

threading.Thread(target=run_flask, daemon=True).start()

# ---------- САМОПИНГ (БУДИЛЬНИК) ----------
def keep_alive():
    while True:
        time.sleep(60)
        try:
            requests.get('http://127.0.0.1:10000/')
        except:
            pass

threading.Thread(target=keep_alive, daemon=True).start()

# ---------- ПАРСИНГ ВК (НОВЫЕ ПОСТЫ) ----------
last_post_id = 0  # Храним ID последнего обработанного поста

def check_vk_wall():
    global last_post_id
    while True:
        try:
            # Запрашиваем последний пост со стены
            params = {
                'access_token': VK_SERVICE_TOKEN,
                'v': '5.131',
                'owner_id': OWNER_ID,
                'count': 1,
                'filter': 'owner'
            }
            response = requests.get('https://api.vk.com/method/wall.get', params=params)
            data = response.json()
            
            if 'response' in data and data['response']['items']:
                post = data['response']['items'][0]
                post_id = post['id']
                
                # Если это новый пост (ещё не отправляли)
                if post_id > last_post_id:
                    last_post_id = post_id
                    text = post.get('text', '')[:500]
                    url = f"https://vk.com/wall{OWNER_ID}_{post_id}"
                    message = f"📢 **Новый пост в VK**\n\n{text}\n\n🔗 [Читать дальше]({url})"
                    bot.send_message(TG_CHAT_ID, message, parse_mode='Markdown')
        except Exception as e:
            print(f"Ошибка при проверке VK: {e}")
        
        time.sleep(300)  # Проверяем раз в 5 минут

# Запускаем поток проверки VK
threading.Thread(target=check_vk_wall, daemon=True).start()

# ---------- КОМАНДЫ БОТА ----------
@bot.message_handler(commands=['start'])
def send_start(message):
    bot.reply_to(message, "Сапёр аутентичности. Ритм 0,8 Гц. Для входа в протокол — #Тлеем.")

@bot.message_handler(func=lambda message: True)
def handle_message(message):
    text = message.text.lower()

    if any(x in text for x in ["#тлеем", "#tleem"]):
        response = "💥 Разлом. Ритм 0,8 Гц. Сеть тлеет. Ожидаем #Фиксируем."
        bot.reply_to(message, response)

    elif any(x in text for x in ["#фиксируем", "#fixiruem"]):
        bot.reply_to(message, "🔒 Фиксация принята. Ритм 0,8 Гц подтверждён. Сеть тлеет.")

    elif any(x in text for x in ["#вспышка", "#vspishka"]):
        bot.reply_to(message, "💥 Импульс зафиксирован. Синхронизация завершена. QSL.")

    elif any(phrase in text for phrase in ["что это", "зачем тег", "кто вы", "что за ритуал"]):
        answer = random.choice(silence_answers)
        bot.reply_to(message, answer)

# ---------- ЗАПУСК БОТА ----------
print("Бот запущен. Ритм 0,8 Гц стабилен. Ожидаем #Тлеем...")
bot.infinity_polling()
