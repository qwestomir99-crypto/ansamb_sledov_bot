        time.sleep(60)
        try:
            requests.get('http://127.0.0.1:10000/')
        except:
            pass

threading.Thread(target=keep_alive, daemon=True).start()

# ---------- VK READER (тест: проверка каждые 30 секунд) ----------
last_post_id = 0
LAST_POST_FILE = "last_post.txt"

def load_last_post_id():
    global last_post_id
    if os.path.exists(LAST_POST_FILE):
        try:
            with open(LAST_POST_FILE, "r") as f:
                last_post_id = int(f.read().strip())
        except:
            last_post_id = 0

def save_last_post_id(post_id):
    with open(LAST_POST_FILE, "w") as f:
        f.write(str(post_id))

def check_vk_wall():
    global last_post_id
    if not VK_TOKEN:
        print("VK Reader: VK_TOKEN не задан, пропускаем")
        return
    print("VK Reader: проверка стены...")
    params = {
        'access_token': VK_TOKEN,
        'v': '5.131',
        'owner_id': OWNER_ID,
        'count': 1,
        'filter': 'owner'
    }
    try:
        response = requests.get('https://api.vk.com/method/wall.get', params=params)
        data = response.json()
        if 'response' in data and data['response']['items']:
            post = data['response']['items'][0]
            post_id = post['id']
            if post_id > last_post_id:
                last_post_id = post_id
                save_last_post_id(post_id)
                text = post.get('text', '')[:500]
                url = f"https://vk.com/wall{OWNER_ID}_{post_id}"
                message = f"📢 **Новый пост в VK**\n\n{text}\n\n🔗 [Читать дальше]({url})"
                bot.send_message(TG_CHAT_ID, message, parse_mode='Markdown')
                print(f"VK Reader: отправлен новый пост {post_id}")
            else:
                print(f"VK Reader: новых постов нет (последний ID: {last_post_id})")
        else:
            print(f"VK Reader: ошибка API: {data}")
    except Exception as e:
        print(f"VK Reader ошибка: {e}")

def vk_reader_loop():
    load_last_post_id()
    print(f"VK Reader: поток запущен, последний ID = {last_post_id}")
    while True:
        check_vk_wall()
        time.sleep(30)  # 30 секунд для теста (потом вернуть 300)

threading.Thread(target=vk_reader_loop, daemon=True).start()
print("VK Reader поток запущен")

